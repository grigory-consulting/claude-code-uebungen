{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "grep -qE \"[.]java|pom[.]xml\" || exit 0; cd \"$CLAUDE_PROJECT_DIR\" && ./mvnw -q -o compile 1>&2 || exit 2",
            "timeout": 180,
            "statusMessage": "Kompiliere nach Änderung"
          }
        ]
      }
    ]
  }
}
