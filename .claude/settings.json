{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "java",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/CompileCheck.java"],
            "timeout": 180,
            "statusMessage": "Kompiliere nach Änderung"
          }
        ]
      }
    ]
  }
}
