{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./daten/echt/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "java",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/IbanCommitSperre.java"],
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Prüfe Commit auf IBANs"
          },
          {
            "type": "command",
            "if": "PowerShell(git *)",
            "command": "java",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/IbanCommitSperre.java"],
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Prüfe Commit auf IBANs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "java",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/KompilierPruefung.java"],
            "timeout": 180,
            "statusMessage": "Kompiliere nach Änderung"
          }
        ]
      }
    ]
  }
}
